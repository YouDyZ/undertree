# Copy to .env and fill in. Never commit .env.
UNDERTREE_PUBLIC_URL=https://<DEINE-DOMAIN.TLD>

# GitHub OAuth (callback: https://<DEINE-DOMAIN.TLD>/api/auth/oauth/github/callback)
UNDERTREE_GITHUB_CLIENT_ID=
UNDERTREE_GITHUB_CLIENT_SECRET=

# Google OAuth (callback: https://<DEINE-DOMAIN.TLD>/api/auth/oauth/google/callback)
UNDERTREE_GOOGLE_CLIENT_ID=
UNDERTREE_GOOGLE_CLIENT_SECRET=

# Restrict the GitLab servers users may connect accounts on (host or host:port, comma-separated;
# the token is only ever sent there). Empty (default): any server reachable from the internet.
# UNDERTREE_GITLAB_HOSTS=gitlab.com

# Key encrypting stored git tokens (base64, 32 bytes). Optional: if unset, data/secret.key is
# generated on first start; set it to keep tokens decryptable if that file is lost.
# UNDERTREE_SECRET_KEY=

# Do NOT set UNDERTREE_DEV_LOGIN in production (refused with https anyway).
# RUST_LOG=undertree=info,tower_http=info

# Spell/grammar check with the LanguageTool sidecar (docs/DEPLOY.md → Spell check, ~1.5 GB RAM).
# Both lines: start the container and point undertree at it. Unset = no spell check.
# COMPOSE_PROFILES=spellcheck
# UNDERTREE_LANGUAGETOOL_URL=http://languagetool:8010
